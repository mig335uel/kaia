{
  "expo": {
    "name": "kaia",
    "slug": "kaia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kaiaLogo.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "43721e01-a8ee-47cc-a8a8-7298efe45d88"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agoras.kaia",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location-update",
          "voip"
        ],
        "NSPhotoLibraryUsageDescription": "Kaia necesita acceder a tu fototeca para que puedas seleccionar fotos y vídeos para tu perfil, chats y publicaciones.",
        "NSMicrophoneUsageDescription": "Kaia necesita acceder al micrófono para realizar llamadas de voz y participar en VoiceGame.",
        "NSCameraUsageDescription": "Kaia necesita acceder a la cámara para que puedas hacer fotos y vídeos para tu perfil, chats y publicaciones.",
        "NSLocationWhenInUseUsageDescription": "Kaia necesita acceder a tu ubicación para mostrarte contenido cercano.",
        "NSUserTrackingUsageDescription": "Este permiso nos ayuda a ofrecer anuncios personalizados y a financiar el desarrollo de Kaia.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/kaiaLogo.png",
        "backgroundImage": "./assets/kaiaLogo.png",
        "monochromeImage": "./assets/kaiaLogo.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_INTERNAL_STORAGE",
        "android.permission.WRITE_INTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.agoras.kaia",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8578170674294985~2993770475",
          "iosAppId": "ca-app-pub-8578170674294985~8166206105"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static",
            "buildReactNativeFromSource": false,
            "extraPods": [
              {
                "name": "FirebaseCore",
                "modular_headers": true
              }
            ],
            "release": {
              "deadCodeStripping": true,
              "stripDebugSymbolsDuringCopy": true,
              "optimizationLevel": "s"
            }
          },
          "android": {
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class javax.crypto.** { *; }\n-keep class java.security.** { *; }\n-keep class com.antihodio.agora.interceptors.** { *; }\n-keepattributes Signature, *Annotation*, EnclosingMethod\n-keep class okhttp3.** { *; }\n-dontwarn okhttp3.**"
          }
        }
      ],
      "expo-localization"
    ]
  }
}