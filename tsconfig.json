{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@Components/*": ["./src/Components/*"],
      "@lib/*": ["./src/lib/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@Services/*": ["./src/Services/*"],
      "@assets/*": ["./assets/*"]
    }
  }
}
